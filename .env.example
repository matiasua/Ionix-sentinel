POSTGRES_DB=ionix_sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password
POSTGRES_PORT=5432

BACKEND_PORT=3000
DATABASE_URL=postgresql://sentinel_user:sentinel_password@postgres:5432/ionix_sentinel

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# Rama "live-scan" del selector de ramas (backend/src/scan/service.ts):
# corre el pipeline real (Analizador Estático + Motor de Razonamiento) en
# vez de un catálogo semilla. Ruta EN TU MÁQUINA (host) al checkout de
# pci-dss-vulnerable-demo (rama pci-vulnerable-demo) — docker-compose la
# monta de solo lectura dentro del contenedor en /app/scan-target.
SCAN_TARGET_HOST_PATH=../pci-dss-vulnerable-demo

# Si corres el backend SIN docker (ej. npm run dev directo en backend/),
# usa esta variable en su lugar con la ruta real de tu máquina — no la
# fija /app/scan-target de arriba, que solo existe dentro del contenedor.
SCAN_TARGET_PATH=../pci-dss-vulnerable-demo

# Motor de Razonamiento (Claude Sonnet, backend/src/reasoning/), usado por
# la rama "live-scan". Sin esto, esa rama funciona igual pero cada
# finding queda con reasoningStatus: "error" (respaldo en vez de la
# explicación/remediación de Claude). El resto de las ramas (seeds) no
# depende de esto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

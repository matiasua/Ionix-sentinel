POSTGRES_DB=ionix_sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password
POSTGRES_PORT=5432

BACKEND_PORT=3000
DATABASE_URL=postgresql://sentinel_user:sentinel_password@postgres:5432/ionix_sentinel

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# Ruta EN TU MÁQUINA (host) al checkout de pci-dss-vulnerable-demo (rama
# pci-vulnerable-demo). docker-compose la monta de solo lectura dentro del
# contenedor del backend en /app/scan-target (ver docker-compose.yml) — el
# backend usa esa ruta fija del contenedor, no esta, para POST /api/scan
# cuando el request no manda { path } en el body. Ajusta esto si tu
# checkout no vive como carpeta hermana de este repo (ver HU-B1.1 en
# docs/epicas-historias.md).
SCAN_TARGET_HOST_PATH=../pci-dss-vulnerable-demo

# Si corres el backend SIN docker (ej. npm run dev directo en backend/),
# usa esta variable en su lugar con la ruta real de tu máquina — no la
# fija /app/scan-target de arriba, que solo existe dentro del contenedor.
SCAN_TARGET_PATH=../pci-dss-vulnerable-demo
